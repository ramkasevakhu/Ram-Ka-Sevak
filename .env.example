# ==========================================
# RAM KA SEVAK (ramkasevak.org) CONFIGURATION
# ==========================================

# 1. Public App & Fallback UPI Details
NEXT_PUBLIC_APP_URL=https://ramkasevak.org
NEXT_PUBLIC_UPI_ID=vipuone@upi
NEXT_PUBLIC_UPI_NAME=Ram Ka Sevak

# 2. Supabase (Free Tier Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. Admin Panel (/admin) Credentials
# Generate ADMIN_PASSWORD_HASH with:
# node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex');console.log('scrypt$'+s+'$'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
ADMIN_USERNAME=vipuone
ADMIN_PASSWORD_HASH=scrypt$replace_salt$replace_hash
ADMIN_JWT_SECRET=replace_with_at_least_32_random_characters

# 4. ZapUPI Payment Gateway (Server-side only — NEVER expose in frontend)
ZAP_KEY=your_zapupi_api_key
ZAP_WEBHOOK_SECRET=optional_random_secret_for_webhook_url_token
